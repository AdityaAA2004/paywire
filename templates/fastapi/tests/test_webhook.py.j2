"""
Webhook security and idempotency tests.

These run against stripe-mock (see conftest.py).
Start stripe-mock: docker compose -f docker-compose.stripe-mock.yml up -d
"""

import pytest


# --- Security tests ---

@pytest.mark.asyncio
async def test_valid_signature_returns_200(client, make_webhook_payload):
    payload, headers = make_webhook_payload(
        "checkout.session.completed",
        {"id": "cs_test_xxx", "mode": "subscription"},
    )
    response = await client.post("/webhooks/stripe", content=payload, headers=headers)
    assert response.status_code == 200


@pytest.mark.asyncio
async def test_missing_signature_returns_400(client, make_webhook_payload):
    payload, _ = make_webhook_payload("checkout.session.completed", {"id": "cs_test_xxx"})
    response = await client.post(
        "/webhooks/stripe",
        content=payload,
        headers={"content-type": "application/json"},
    )
    assert response.status_code == 400


@pytest.mark.asyncio
async def test_tampered_signature_returns_400(client, make_webhook_payload):
    payload, headers = make_webhook_payload("checkout.session.completed", {"id": "cs_test_xxx"})
    headers["stripe-signature"] = headers["stripe-signature"] + "tampered"
    response = await client.post("/webhooks/stripe", content=payload, headers=headers)
    assert response.status_code == 400


@pytest.mark.asyncio
async def test_wrong_secret_returns_400(client, make_webhook_payload):
    payload, headers = make_webhook_payload(
        "checkout.session.completed",
        {"id": "cs_test_xxx"},
        secret="whsec_wrong_secret",
    )
    response = await client.post("/webhooks/stripe", content=payload, headers=headers)
    assert response.status_code == 400


# --- Idempotency tests ---

@pytest.mark.asyncio
async def test_duplicate_event_returns_200_without_double_processing(
    client, make_webhook_payload
):
    payload, headers = make_webhook_payload(
        "invoice.paid",
        {"id": "in_test_dup"},
    )
    # First delivery — should process.
    r1 = await client.post("/webhooks/stripe", content=payload, headers=headers)
    assert r1.status_code == 200
    assert r1.json()["status"] != "already_processed"

    # Second delivery — same event_id — should be a no-op.
    r2 = await client.post("/webhooks/stripe", content=payload, headers=headers)
    assert r2.status_code == 200
    assert r2.json()["status"] == "already_processed"


