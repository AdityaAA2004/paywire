"""
Subscription lifecycle event handlers.

SRP: each class handles one subscription event type.
DIP: depends on StripeSubscriptionProtocol, not BillingService directly.
"""

from __future__ import annotations

from sqlalchemy.ext.asyncio import AsyncSession

from .base import HandlerError
from ..services.billing_service import StripeSubscriptionProtocol
from ..services.subscription_service import SubscriptionService


class SubscriptionDeletedHandler:
    event_type = "customer.subscription.deleted"

    def __init__(
        self,
        stripe_svc: StripeSubscriptionProtocol,
        subscription_svc: SubscriptionService,
    ) -> None:
        self._stripe_svc = stripe_svc
        self._subscription_svc = subscription_svc

    async def handle(self, event_object: dict, db: AsyncSession) -> None:
        # Refetch from Stripe for canonical data.
        subscription = await self._stripe_svc.retrieve_subscription(event_object["id"])
        await self._subscription_svc.cancel_subscription(
            stripe_subscription_id=subscription["id"],
            db=db,
        )


