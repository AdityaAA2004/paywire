        # Decide which service method to call based on your app's needs:
        #
        # For a new subscription (amount_paid may be 0 for trials):
        #   await self._subscription_svc.activate_subscription(...)
        #
        # For a renewal:
        #   await self._subscription_svc.renew_subscription(
        #       stripe_subscription_id=subscription_id,
        #       stripe_price_id=price_id,
        #       current_period_end=current_period_end,
        #       db=db,
        #   )
