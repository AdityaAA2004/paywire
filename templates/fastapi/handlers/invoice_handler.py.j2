class InvoicePaymentFailedHandler:
    event_type = "invoice.payment_failed"

    def __init__(
        self,
        stripe_svc: StripeSubscriptionProtocol,
        subscription_svc: SubscriptionService,
    ) -> None:
        self._stripe_svc = stripe_svc
        self._subscription_svc = subscription_svc

    async def handle(self, event_object: dict, db: AsyncSession) -> None:
        invoice = await self._stripe_svc.retrieve_invoice(event_object["id"])

        subscription_id: str | None = invoice.get("subscription")
        if not subscription_id:
            return

        next_attempt_ts: int | None = invoice.get("next_payment_attempt")
        next_attempt = (
            datetime.fromtimestamp(next_attempt_ts, tz=timezone.utc)
            if next_attempt_ts
            else None
        )

        await self._subscription_svc.handle_payment_failure(
            stripe_subscription_id=subscription_id,
            next_payment_attempt=next_attempt,
            db=db,
        )
