# Stripe Payment Integration — Environment Variables
# Copy relevant values into your .env file.
# Never commit .env to version control.

# --- Stripe Keys ---
# Use a Restricted Key (rk_ prefix) — never the secret key (sk_ prefix).
# Create at: https://dashboard.stripe.com/apikeys
STRIPE_RESTRICTED_KEY=rk_test_...

# Publishable key for client-side Stripe.js / Payment Element
STRIPE_PUBLISHABLE_KEY=pk_test_...

# --- Webhook Secrets ---
# Use separate secrets for test and live modes.
# Obtain from: Stripe Dashboard → Developers → Webhooks → [endpoint] → Signing secret
# Or via Stripe CLI: stripe listen → displayed in terminal as "whsec_..."
STRIPE_WEBHOOK_SECRET_TEST=whsec_...
STRIPE_WEBHOOK_SECRET_LIVE=whsec_...

# --- Price IDs (populated by provision_stripe.py) ---
# Run: python3 scripts/provision_stripe.py --config pricing-tiers.yaml
{% for tier in pricing_tiers %}
STRIPE_PRICE_ID_{{ tier.name | upper }}=price_...
{% endfor %}

# --- Active webhook secret selector ---
# Set to "test" in development, "live" in production.
# The app reads STRIPE_WEBHOOK_SECRET_{STRIPE_ENV | upper} at startup.
STRIPE_ENV=test

# --- Stripe API Version ---
STRIPE_API_VERSION=2026-04-22.dahlia

# --- stripe-mock (local development only) ---
# Start with: docker compose -f docker-compose.stripe-mock.yml up
# STRIPE_MOCK_HOST=http://localhost:12111
